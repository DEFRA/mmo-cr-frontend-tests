# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# Never commit real values — this file is a template only.
# ─────────────────────────────────────────────────────────────────────────────

# Target environment: local | dev | test | prod
ENVIRONMENT=local

# Base URL of the frontend under test
BASE_URL=http://localhost:3000

# Headless browser mode (true in CI, false for local debugging)
HEADLESS=true

# Number of parallel Playwright workers (defaults to CPU count in CI)
WORKERS=1

# Slow-motion delay between actions in ms (0 = off; useful for debugging)
SLOW_MO=0

# Optional: HTTP proxy for CDP environments
# HTTP_PROXY=http://proxy.example.com:3128

# Optional: ChromeDriver URL override (used in CDP remote runner)
# CHROMEDRIVER_URL=127.0.0.1
# CHROMEDRIVER_PORT=4444
